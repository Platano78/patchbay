{
  "local": {
    "label": "Local — Ollama",
    "base_url": "http://localhost:11434/v1",
    "model": "auto",
    "available": true
  },
  "local-alt": {
    "label": "Local — llama.cpp / LM Studio",
    "base_url": "http://localhost:8080/v1",
    "model": "auto",
    "available": false,
    "note": "llama.cpp's llama-server defaults to :8080; LM Studio's local server defaults to :1234; a llama.cpp router setup is often :8081. Point base_url at whichever one you run."
  },
  "frontier": {
    "label": "Frontier — hosted model (any OpenAI-compatible endpoint)",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "<YOUR_FRONTIER_MODEL>",
    "api_key_file": "<PATH>/openrouter.env",
    "api_key_var": "OPENROUTER_API_KEY",
    "available": false,
    "note": "set your key file and model, then flip available to true. (This lane was previously named \"claude\"; an old brains.json using that key keeps working — brains.json keys are free-form.)"
  }
}
